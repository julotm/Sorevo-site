---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/500.css';
import '@fontsource/hanken-grotesk/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import { t, langs, type Lang } from '../i18n/content';
const { lang, path = '', title, desc, jsonld = [], og = 'website' } = Astro.props as { lang: Lang; path?: string; title: string; desc: string; jsonld?: object[]; og?: string };
const base = 'https://sorevo.eu';
const c = t[lang];
const logo = `<svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><path d="M25 7H13.5A4.5 4.5 0 0 0 13.5 16H18.5A4.5 4.5 0 0 1 18.5 25H7" fill="none" stroke="#C6F24E" stroke-width="3.2"/></svg>`;
const L = `/${lang}`;
---
<!doctype html>
<html lang={c.htmlLang}>
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title><meta name="description" content={desc} />
<link rel="canonical" href={`${base}/${lang}/${path}`} />
{langs.map(l => <link rel="alternate" hreflang={l} href={`${base}/${l}/${path}`} />)}
<link rel="alternate" hreflang="x-default" href={`${base}/fr/${path}`} />
<meta property="og:title" content={title} /><meta property="og:description" content={desc} /><meta property="og:type" content={og} /><meta property="og:url" content={`${base}/${lang}/${path}`} /><meta property="og:site_name" content="Sorevo" /><meta property="og:locale" content={c.locale} />
<meta property="og:image" content={`${base}/og.png`} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:image" content={`${base}/og.png`} />
<meta name="theme-color" content="#0B0F14" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
{jsonld.map(j => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body>
<header class="top"><div class="wrap bar">
  <a class="brand" href={`${L}/`} set:html={`${logo}<span>Sorevo</span>`} />
  <nav class="links" aria-label="Principal">
    <a href={`${L}/#offre`}>{c.nav.offer}</a><a href={`${L}/#methode`}>{c.nav.method}</a><a href={`${L}/guides/`}>{c.nav.guides}</a><a href={`${L}/about/`}>{c.nav.about}</a><a href={`${L}/faq/`}>{c.nav.faq}</a>
  </nav>
  <div class="right"><span class="langs">{langs.map((l, i) => <><a href={`/${l}/${path}`} class={l === lang ? 'on' : ''} hreflang={l}>{l.toUpperCase()}</a>{i < 2 && <i>/</i>}</>)}</span><a class="cta-s" href={`${L}/#audit`}>{c.nav.cta} →</a></div>
</div></header>
<main><slot /></main>
<footer class="foot"><div class="wrap fgrid">
  <div><a class="brand" href={`${L}/`} set:html={`${logo}<span>Sorevo</span>`} /><p class="mu">{c.footer.tag}</p></div>
  <div><p class="mono">{c.footer.nav}</p><a href={`${L}/#offre`}>{c.nav.offer}</a><a href={`${L}/guides/`}>{c.nav.guides}</a><a href={`${L}/about/`}>{c.nav.about}</a><a href={`${L}/faq/`}>{c.nav.faq}</a></div>
  <div><p class="mono">{c.footer.lang}</p>{langs.map(l => <a href={`/${l}/${path}`} hreflang={l}>{l.toUpperCase()}</a>)}</div>
  <div class="fine"><a href={`${L}/legal/`}>{c.footer.legal}</a><a href={`${L}/privacy/`}>{c.footer.privacy}</a><span>© {new Date().getFullYear()} Sorevo. {c.footer.rights}</span></div>
</div></footer>
<style is:global>
:root{--bg:#0B0F14;--tx:#ECEFE8;--mu:#A4AEA8;--mu2:#6B756F;--ln:#26302C;--lime:#C6F24E}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--tx);font:400 17px/1.65 'Hanken Grotesk',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:'Fraunces Variable',Georgia,serif;font-weight:400;line-height:1.05;letter-spacing:-.02em;margin:0}
em{font-style:italic;color:var(--lime)}a{color:inherit}.wrap{max-width:1200px;margin:0 auto;padding:0 28px}
.mono,.lab,.when{font:500 12px 'JetBrains Mono',monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--mu2)}.mu{color:var(--mu)}
.top{position:sticky;top:0;z-index:20;background:rgba(11,15,20,.9);backdrop-filter:blur(8px);border-bottom:1px solid var(--ln)}
.bar{display:flex;align-items:center;gap:28px;height:64px}
.brand{display:inline-flex;align-items:center;gap:10px;text-decoration:none;font:500 24px 'Fraunces Variable',serif;letter-spacing:-.02em}
.links{display:flex;gap:24px;flex:1;margin-left:16px}.links a{color:var(--mu);text-decoration:none;font-size:15px}.links a:hover{color:var(--lime)}
.right{display:flex;align-items:center;gap:18px}.langs{font:500 12px 'JetBrains Mono',monospace;color:var(--mu2);display:flex;gap:6px}.langs a{text-decoration:none}.langs a.on{color:var(--lime)}
.cta-s{font-size:14px;font-weight:600;color:var(--bg);background:var(--lime);padding:9px 16px;text-decoration:none}
.btn{display:inline-block;background:var(--lime);color:var(--bg);padding:15px 26px;font-weight:600;text-decoration:none;border:0;font-size:16px;cursor:pointer;font-family:inherit}.btn:hover{filter:brightness(1.08)}
.lnk{font-weight:600;text-decoration:none;border-bottom:1px solid var(--lime);padding-bottom:2px}.lnk:hover{color:var(--lime)}
.hero{padding:104px 0 56px}.hero h1{font-size:clamp(46px,8.4vw,112px);max-width:12ch}
.hero .sub{font-size:20px;color:var(--mu);max-width:620px;margin:32px 0}.row{display:flex;gap:28px;align-items:center;flex-wrap:wrap}
.disc{font-size:13px;color:var(--mu2);margin-top:20px}
.strip{border-block:1px solid var(--ln);padding:18px 0}.strip .wrap{display:flex;gap:36px;align-items:baseline;flex-wrap:wrap}.strip b{font:400 26px 'Fraunces Variable',serif}
.sec{border-top:1px solid var(--ln);padding:72px 0}.grid{display:grid;grid-template-columns:240px 1fr;gap:40px}
.sec h2{font-size:clamp(32px,4.4vw,56px);margin-bottom:36px;max-width:18ch}
.lst>div{display:grid;grid-template-columns:56px 1fr;gap:12px;padding:22px 0;border-top:1px solid var(--ln)}.lst h3{font-size:24px;margin-bottom:6px}.lst p{margin:0;color:var(--mu);max-width:640px}
.lst .num{font:500 13px 'JetBrains Mono',monospace;color:var(--lime);padding-top:6px}
.steps>div{display:grid;grid-template-columns:180px 160px 1fr;gap:24px;padding:24px 0;border-top:1px solid var(--ln)}.steps h3{font-size:28px}.steps p{margin:0;color:var(--mu)}
.demo{border:1px solid var(--ln);padding:28px;max-width:760px}.demo .in{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px}
.tabs{display:flex;gap:0;margin-bottom:18px}.tabs button{font:500 12px 'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.08em;background:transparent;color:var(--mu);border:1px solid var(--ln);padding:9px 16px;cursor:pointer}.tabs button.on{background:var(--lime);color:var(--bg);border-color:var(--lime)}
.chat{display:grid;gap:14px}.chat .who{display:block;font:500 11px 'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.08em;color:var(--mu2);margin-bottom:6px}.chat .u{justify-self:end;max-width:85%;background:#151B22;border:1px solid var(--ln);padding:12px 16px}.chat .u p{margin:0;font:italic 400 19px 'Fraunces Variable',serif}.chat .ai{border-left:2px solid var(--ln);padding:4px 0 4px 18px}.chat .ai p{margin:0 0 10px}.chat .ai ul{margin:0 0 10px;padding-left:18px;color:var(--mu)}.chat .ai li{margin:6px 0}.chat .ai li.me{color:var(--tx);list-style:none;margin-left:-18px;padding:10px 12px;border:1px solid var(--lime)}.chat .ai li.me strong{color:var(--lime)}.chat .ai .src{font:400 12px 'JetBrains Mono',monospace;color:var(--mu2)}
.demo small{display:block;margin-top:14px;color:var(--mu2);font-size:13px}
.offerbox{display:grid;grid-template-columns:1fr 1.3fr;gap:48px}.price{font:300 clamp(64px,9vw,120px) 'Fraunces Variable',serif;line-height:1;color:var(--lime)}
.ticks{list-style:none;padding:0;margin:0 0 28px}.ticks li{padding:12px 0 12px 32px;border-top:1px solid var(--ln);position:relative}.ticks li:before{content:'+';position:absolute;left:0;color:var(--lime);font-family:'JetBrains Mono',monospace}.ticks.no li:before{content:'×';color:var(--mu2)}
.offerbox h3{font-size:22px;margin:30px 0 6px}.two{display:grid;grid-template-columns:1fr 1fr;gap:40px}
details{border-top:1px solid var(--ln);padding:20px 0}summary{cursor:pointer;font:400 24px 'Fraunces Variable',serif;list-style:none}summary::-webkit-details-marker{display:none}summary:after{content:'+';float:right;color:var(--lime)}details[open] summary:after{content:'−'}details p{color:var(--mu);margin:.8em 0 0;max-width:680px}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid var(--ln)}.cards a{padding:26px 24px 26px 0;text-decoration:none;border-right:1px solid var(--ln);margin-right:24px}.cards a:last-child{border:0}.cards h3{font-size:26px;margin:10px 0}.cards p{color:var(--mu);margin:0;font-size:15px}
form{display:grid;gap:26px;max-width:640px}label{display:grid;gap:6px;font:500 12px 'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.06em;color:var(--mu2)}
input,textarea{background:transparent;border:0;border-bottom:1px solid var(--mu2);color:var(--tx);font:400 19px 'Hanken Grotesk',sans-serif;padding:8px 0;border-radius:0}input:focus,textarea:focus{outline:0;border-color:var(--lime)}
.chk{display:flex;gap:10px;align-items:flex-start;font:400 14px 'Hanken Grotesk',sans-serif;text-transform:none;letter-spacing:0;color:var(--mu)}.chk input{margin-top:5px;accent-color:var(--lime)}.hp{position:absolute;left:-9999px;opacity:0}
.msg{margin:0;font-size:15px}.msg.ok{color:var(--lime)}.msg.err{color:#ff8a8a}
.page{padding:80px 0}.page h1{font-size:clamp(42px,6vw,84px);margin-bottom:24px}.page .lead{font-size:22px;color:var(--mu);max-width:640px}.art{max-width:680px}.art p{margin:0 0 1.1em}
.foot{border-top:1px solid var(--ln);padding:56px 0 32px}.fgrid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:40px}.fgrid a{display:block;text-decoration:none;color:var(--mu);padding:3px 0}.fgrid .brand{display:inline-flex;color:var(--tx)}.fine{grid-column:1/-1;border-top:1px solid var(--ln);padding-top:20px;display:flex;gap:24px;color:var(--mu2);font-size:13px;flex-wrap:wrap}.fine a{display:inline;color:var(--mu2)}
@media(max-width:860px){.links,.langs{display:none}.grid,.offerbox,.two,.cards,.steps>div,.fgrid{grid-template-columns:1fr}.cards a{border:0;border-top:1px solid var(--ln);margin:0}.demo .in{grid-template-columns:1fr}.hero{padding-top:56px}}
</style>
</body>
</html>
