---
import { content, langs, type Lang } from '../i18n/content';
const { lang, path = '', title, desc, jsonld = [] } = Astro.props as { lang: Lang; path?: string; title: string; desc: string; jsonld?: object[] };
const base = 'https://sorevo.vercel.app';
const c = content[lang];
const labels: Record<string, string> = { fr: 'FR', en: 'EN', es: 'ES' };
const logo = `<svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#C6F24E"/><circle cx="9.5" cy="15" r="3.2" fill="#0B0F14"/><circle cx="18.5" cy="15" r="3.2" fill="#0B0F14"/><path d="M12.7 15c0 3-1.6 5-4.2 6.2M21.7 15c0 3-1.6 5-4.2 6.2" stroke="#0B0F14" stroke-width="2.4" stroke-linecap="round" fill="none"/></svg>`;
---
<!doctype html>
<html lang={c.htmlLang}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={`${base}/${lang}/${path}`} />
{langs.map(l => <link rel="alternate" hreflang={l} href={`${base}/${l}/${path}`} />)}
<link rel="alternate" hreflang="x-default" href={`${base}/fr/${path}`} />
<meta property="og:title" content={title} /><meta property="og:description" content={desc} />
<meta property="og:type" content="website" /><meta property="og:url" content={`${base}/${lang}/${path}`} /><meta property="og:site_name" content="Sorevo" />
<meta name="theme-color" content="#0B0F14" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
{jsonld.map(j => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body>
<header class="nav"><div class="wrap navin">
  <a class="brand" href={`/${lang}/`} set:html={`${logo}<span>Sorevo</span>`} />
  <nav class="links" aria-label="Principal">
    <a href={`/${lang}/#offre`}>{c.nav.offer}</a><a href={`/${lang}/#methode`}>{c.nav.method}</a><a href={`/${lang}/#pilote`}>{c.nav.pilot}</a><a href={`/${lang}/#faq`}>{c.nav.faq}</a>
  </nav>
  <div class="right"><span class="langs">{langs.map((l, i) => <><a href={`/${l}/${path}`} class={l === lang ? 'on' : ''} hreflang={l}>{labels[l]}</a>{i < 2 && <i>·</i>}</>)}</span><a class="pill" href={`/${lang}/#audit`}>{c.nav.cta}</a></div>
</div></header>
<main><slot /></main>
<footer class="foot"><div class="wrap footin">
  <a class="brand" href={`/${lang}/`} set:html={`${logo}<span>Sorevo</span>`} />
  <p>{c.footer.tag}</p>
  <p><a href={`/${lang}/legal/`}>{c.footer.legal}</a> · © {new Date().getFullYear()} Sorevo. {c.footer.rights}</p>
</div></footer>
<style is:global>
:root{--bg:#0B0F14;--tx:#E8ECF1;--mu:#A9B3C0;--mu2:#6B7685;--card:#121923;--bd:#232D3A;--lime:#C6F24E}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--tx);font-family:Inter,system-ui,sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:'Space Grotesk',Inter,sans-serif;line-height:1.1;margin:0 0 .5em;letter-spacing:-.02em}
a{color:inherit}.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
.nav{position:sticky;top:0;z-index:10;background:rgba(11,15,20,.85);backdrop-filter:blur(10px);border-bottom:1px solid var(--bd)}
.navin{display:flex;align-items:center;gap:24px;height:68px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;font:700 22px 'Space Grotesk',sans-serif}
.links{display:flex;gap:22px;margin-left:12px;flex:1}.links a{color:var(--mu);text-decoration:none;font-size:15px}.links a:hover{color:var(--tx)}
.right{display:flex;align-items:center;gap:16px}.langs{font-size:13px;color:var(--mu2);display:flex;gap:6px}.langs i{font-style:normal}.langs a{text-decoration:none}.langs a.on{color:var(--lime);font-weight:600}
.pill{background:var(--lime);color:var(--bg);padding:9px 18px;border-radius:999px;font-weight:600;text-decoration:none;font-size:14px}
.btn{display:inline-block;background:var(--lime);color:var(--bg);padding:14px 26px;border-radius:12px;font-weight:600;text-decoration:none;border:0;font-size:16px;cursor:pointer;font-family:inherit}
.btn.ghost{background:transparent;color:var(--tx);border:1px solid var(--bd)}.btn:hover{filter:brightness(1.07)}
section{padding:84px 0}.label{color:var(--lime);font:600 12px Inter;letter-spacing:.14em;margin-bottom:18px}
.hero{padding:96px 0 72px}.hero .grid{display:grid;grid-template-columns:1.15fr .85fr;gap:56px;align-items:center}
.hero h1{font-size:clamp(40px,6vw,64px)}.hero p.sub{font-size:19px;color:var(--mu);max-width:560px}.cta-row{display:flex;gap:14px;flex-wrap:wrap;margin:28px 0 16px}
.disc{font-size:13px;color:var(--mu2)}
.mock{background:var(--card);border:1px solid var(--bd);border-radius:20px;padding:22px}
.mock .q{background:#1A2330;border-radius:14px;padding:14px 16px;font-size:14px;color:var(--mu);margin-bottom:14px}
.mock .row{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:12px;border:1px solid var(--bd);margin-bottom:10px;font-size:15px;color:var(--mu)}
.mock .row.me{border-color:var(--lime);color:var(--tx);background:rgba(198,242,78,.07)}.mock .n{width:24px;height:24px;border-radius:50%;background:#1A2330;display:grid;place-items:center;font-size:12px}
.mock .row.me .n{background:var(--lime);color:var(--bg);font-weight:700}.mock small{display:block;color:var(--mu2);font-size:12px;margin-top:6px}
h2{font-size:clamp(30px,4vw,44px)}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:36px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:18px;padding:26px}.card h3{font-size:20px}.card p{color:var(--mu);margin:0;font-size:15px}
.alt{background:#0E141B;border-block:1px solid var(--bd)}
.offer{background:var(--lime);color:var(--bg);border-radius:28px;padding:48px;display:grid;grid-template-columns:.8fr 1.2fr;gap:48px}
.offer h2{color:var(--bg)}.offer .price{font:700 64px 'Space Grotesk';line-height:1}.offer p{margin:.6em 0}
.offer ul{list-style:none;margin:0 0 20px;padding:0}.offer li{padding:10px 0 10px 28px;border-bottom:1px solid rgba(11,15,20,.15);position:relative;font-size:15px}.offer li:before{content:'✓';position:absolute;left:0;font-weight:700}
.offer h3{font-size:16px;margin:22px 0 6px}.offer li.x:before{content:'✕'}
.offer .btn{background:var(--bg);color:var(--lime)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:32px}.two ul{margin:0;padding-left:20px;color:var(--mu)}
details{border-bottom:1px solid var(--bd);padding:18px 0}summary{cursor:pointer;font:600 18px 'Space Grotesk';list-style:none}summary::-webkit-details-marker{display:none}details p{color:var(--mu);margin:.7em 0 0}
form{background:var(--card);border:1px solid var(--bd);border-radius:20px;padding:32px;max-width:640px;display:grid;gap:16px;margin-top:28px}
label{font-size:14px;color:var(--mu);display:grid;gap:6px}input,textarea{background:var(--bg);border:1px solid var(--bd);border-radius:10px;padding:12px 14px;color:var(--tx);font:inherit}input:focus,textarea:focus{outline:2px solid var(--lime);outline-offset:1px}
.chk{display:flex;gap:10px;align-items:flex-start;font-size:13px}.chk input{margin-top:4px}.hp{position:absolute;left:-9999px;opacity:0}
.msg{font-size:15px}.msg.ok{color:var(--lime)}.msg.err{color:#ff8a8a}
.foot{border-top:1px solid var(--bd);padding:40px 0;color:var(--mu);font-size:14px}.footin{display:grid;gap:8px}.foot a{color:var(--mu)}
.legal{padding:72px 0;max-width:760px}.legal p{color:var(--mu)}
@media(max-width:860px){.links{display:none}.hero .grid,.offer,.two,.cards{grid-template-columns:1fr}.offer{padding:30px}.langs{display:none}}
</style>
</body>
</html>
