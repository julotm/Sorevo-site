---
import Base from '../../layouts/Base.astro';
import { t, langs, slugs, type Lang } from '../../i18n/content';
export function getStaticPaths() { return langs.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const c = t[lang]; const L = `/${lang}`; const base = 'https://sorevo.vercel.app';
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'ProfessionalService', name: 'Sorevo', url: `${base}/${lang}/`, description: c.desc, areaServed: { '@type': 'City', name: 'Barcelona' }, knowsLanguage: ['fr', 'en', 'es'], serviceType: 'Generative Engine Optimization (GEO/AEO)' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqPage.items.slice(0, 4).map((i: any) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })) },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Sorevo', url: `${base}/${lang}/`, inLanguage: lang }
];
const url = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const key = import.meta.env.PUBLIC_SUPABASE_KEY ?? '';
const Sec = ({ s }: any) => s;
---
<Base lang={lang} title={c.title} desc={c.desc} jsonld={jsonld}>
<section class="hero"><div class="wrap">
  <p class="mono">{c.hero.label}</p>
  <h1 style="margin-top:20px">{c.hero.a}<em>{c.hero.b}</em>{c.hero.c}</h1>
  <p class="sub">{c.hero.sub}</p>
  <div class="row"><a class="btn" href="#audit">{c.hero.cta1}</a><a class="lnk" href="#offre">{c.hero.cta2} →</a></div>
  <p class="disc">{c.hero.disc}</p>
</div></section>
<div class="strip"><div class="wrap"><span class="mono">{c.hero.engines}</span><b>ChatGPT</b><b>Gemini</b><b>AI Overviews</b><b>Claude</b><b>Perplexity</b></div></div>

<section class="sec"><div class="wrap grid"><p class="lab">{c.s1.n} — {c.s1.label}</p><div><h2>{c.s1.h2}</h2>
  <div class="lst">{c.s1.items.map((i: any, k: number) => <div><span class="num">0{k + 1}</span><div><h3>{i.t}</h3><p>{i.d}</p></div></div>)}</div></div></div></section>

<section class="sec"><div class="wrap grid"><p class="lab">{c.demo.n} — {c.demo.label}</p><div><h2>{c.demo.h2}</h2><p class="mu" style="max-width:560px;margin:-16px 0 28px">{c.demo.d}</p>
  <div class="demo" id="demo" data-q={c.demo.q} data-ca={c.demo.compA} data-cb={c.demo.compB} data-cc={c.demo.compC} data-co={c.demo.companyPh} data-ac={c.demo.activityPh}>
    <div class="in"><label>{c.demo.company}<input id="dc" placeholder={c.demo.companyPh} maxlength="40" /></label><label>{c.demo.activity}<input id="da" placeholder={c.demo.activityPh} maxlength="60" /></label></div>
    <div class="tabs"><button type="button" data-m="b" class="on">{c.demo.before}</button><button type="button" data-m="a">{c.demo.after}</button></div>
    <p class="q" id="dq"></p><div class="ans" id="dans"></div><small>{c.demo.note}</small>
  </div></div></div></section>

<section class="sec" id="methode"><div class="wrap grid"><p class="lab">{c.method.n} — {c.method.label}</p><div><h2>{c.method.h2}</h2>
  <p style="max-width:640px;margin:0 0 32px;opacity:.75">{c.method.note}</p>
  <div class="steps">{c.method.steps.map((s: any) => <div><span class="when">{s.when}</span><h3>{s.t}</h3><p>{s.d}</p></div>)}</div></div></div></section>

<section class="sec" id="offre"><div class="wrap grid"><p class="lab">{c.offer.n} — {c.offer.label}</p><div><h2>{c.offer.h2}</h2>
  <div class="offerbox"><div><p class="mu">{c.offer.intro}</p><div class="price">{c.offer.price}</div><p class="mu">{c.offer.priceNote}</p><p><a class="btn" href="#audit">{c.offer.cta}</a></p></div>
  <div><p class="lab">{c.offer.incH}</p><ul class="ticks">{c.offer.includes.map((i: string) => <li>{i}</li>)}</ul>
  <div class="two"><div><p class="lab">{c.offer.notH}</p><ul class="ticks no">{c.offer.not.map((i: string) => <li>{i}</li>)}</ul></div><div><p class="lab">{c.offer.clientH}</p><ul class="ticks">{c.offer.client.map((i: string) => <li>{i}</li>)}</ul></div></div></div></div></div></div></section>

<section class="sec" id="pilote"><div class="wrap grid"><p class="lab">{c.pilot.n} — {c.pilot.label}</p><div><h2>{c.pilot.h2}</h2><p class="mu" style="max-width:600px;margin:-16px 0 28px">{c.pilot.d}</p>
  <div class="two"><div><p class="lab">{c.pilot.give}</p><ul class="ticks">{c.pilot.gives.map((i: string) => <li>{i}</li>)}</ul></div><div><p class="lab">{c.pilot.get}</p><ul class="ticks">{c.pilot.gets.map((i: string) => <li>{i}</li>)}</ul></div></div>
  <a class="btn" href="#audit">{c.pilot.cta}</a></div></div></section>

<section class="sec" id="audit"><div class="wrap grid"><p class="lab">{c.form.n} — {c.form.label}</p><div><h2>{c.form.h2}</h2><p class="mu" style="margin:-16px 0 32px">{c.form.d}</p>
  <form id="f" data-url={url} data-key={key} data-lang={lang} data-ok={c.form.ok} data-err={c.form.err} data-sending={c.form.sending} data-submit={c.form.submit}>
    <label>{c.form.name}<input name="name" required maxlength="120" autocomplete="name" /></label>
    <label>{c.form.email}<input name="email" type="email" required maxlength="200" autocomplete="email" /></label>
    <label>{c.form.company}<input name="company" required maxlength="160" autocomplete="organization" /></label>
    <label>{c.form.website}<input name="website" type="url" maxlength="300" placeholder="https://" /></label>
    <label>{c.form.service}<textarea name="service" rows="2" maxlength="500" placeholder={c.form.servicePh}></textarea></label>
    <input class="hp" name="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <label class="chk"><input type="checkbox" name="consent" required /><span>{c.form.consent}</span></label>
    <div><button class="btn" type="submit">{c.form.submit}</button></div>
    <p class="msg" id="msg" role="status"></p>
  </form></div></div></section>
</Base>
<script>
  const d = document.getElementById('demo') as HTMLElement | null;
  if (d) {
    let mode = 'b';
    const dc = document.getElementById('dc') as HTMLInputElement, da = document.getElementById('da') as HTMLInputElement;
    const dq = document.getElementById('dq')!, dans = document.getElementById('dans')!;
    const esc = (s: string) => s.replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch] as string));
    const render = () => {
      const co = dc.value.trim() || d.dataset.co!, ac = da.value.trim() || d.dataset.ac!;
      dq.textContent = d.dataset.q!.replace('{a}', ac);
      const rows = mode === 'b' ? [d.dataset.ca, d.dataset.cb, d.dataset.cc] : [d.dataset.ca, co, d.dataset.cb];
      dans.innerHTML = rows.map((r, i) => `<div class="${mode === 'a' && i === 1 ? 'me' : ''}"><b>0${i + 1}</b><span>${esc(String(r))}</span></div>`).join('');
    };
    d.querySelectorAll('.tabs button').forEach(b => b.addEventListener('click', () => { mode = (b as HTMLElement).dataset.m!; d.querySelectorAll('.tabs button').forEach(x => x.classList.toggle('on', x === b)); render(); }));
    dc.addEventListener('input', render); da.addEventListener('input', render); render();
  }
  const f = document.getElementById('f') as HTMLFormElement | null;
  if (f) f.addEventListener('submit', async (e) => {
    e.preventDefault();
    const s = f.dataset; const msg = document.getElementById('msg')!; const btn = f.querySelector('button')!;
    const v = (n: string) => (f.elements.namedItem(n) as HTMLInputElement);
    if (v('hp').value) return;
    btn.disabled = true; btn.textContent = s.sending!; msg.textContent = ''; msg.className = 'msg';
    try {
      const body = { name: v('name').value.trim(), email: v('email').value.trim(), company: v('company').value.trim(), website: v('website').value.trim() || null, service: v('service').value.trim() || null, lang: s.lang, consent: v('consent').checked };
      const r = await fetch(`${s.url}/rest/v1/audit_requests`, { method: 'POST', headers: { 'Content-Type': 'application/json', apikey: s.key!, Authorization: `Bearer ${s.key}`, Prefer: 'return=minimal' }, body: JSON.stringify(body) });
      if (!r.ok) throw new Error(String(r.status));
      msg.textContent = s.ok!; msg.className = 'msg ok'; f.reset();
    } catch { msg.textContent = s.err!; msg.className = 'msg err'; }
    btn.disabled = false; btn.textContent = s.submit!;
  });
</script>
