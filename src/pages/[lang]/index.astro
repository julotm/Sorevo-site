---
import Base from '../../layouts/Base.astro';
import { t, langs, slugs, wiz, type Lang } from '../../i18n/content';
export function getStaticPaths() { return langs.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const c = t[lang]; const w = wiz[lang]; const L = `/${lang}`; const base = 'https://sorevo.eu';
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'ProfessionalService', '@id': `${base}/#org`, name: 'Sorevo', url: `${base}/${lang}/`, logo: `${base}/favicon.svg`, image: `${base}/og.png`, email: 'contact@sorevo.eu', description: c.desc, founder: { '@type': 'Person', name: 'Jules Tommy Martin' }, areaServed: { '@type': 'City', name: 'Barcelona' }, knowsLanguage: ['fr', 'en', 'es'], serviceType: 'Generative Engine Optimization (GEO/AEO)', priceRange: '€', makesOffer: { '@type': 'Offer', name: 'GEO / AI visibility audit and optimisation', description: c.offer.includes.join(' · '), price: '250', priceCurrency: 'EUR', url: `${base}/${lang}/#offre` } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqPage.items.slice(0, 4).map((i: any) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })) },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Sorevo', url: `${base}/${lang}/`, inLanguage: lang }
];
const url = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const key = import.meta.env.PUBLIC_SUPABASE_KEY ?? '';
const Sec = ({ s }: any) => s;
---
<Base lang={lang} title={c.title} desc={c.desc} jsonld={jsonld}>
<section class="hero"><div class="wrap">
  <p class="mono">{c.hero.label}</p>
  <h1 style="margin-top:20px">{c.hero.a}<em>{c.hero.b}</em>{c.hero.c}</h1>
  <p class="sub">{c.hero.sub}</p>
  <div class="row"><a class="btn" href="#audit">{c.hero.cta1}</a><a class="lnk" href="#offre">{c.hero.cta2} →</a></div>
  <p class="disc">{c.hero.disc}</p>
</div></section>
<div class="strip"><div class="wrap"><span class="mono">{c.hero.engines}</span><b>ChatGPT</b><b>Gemini</b><b>AI Overviews</b><b>Claude</b><b>Perplexity</b></div></div>

<section class="sec"><div class="wrap grid"><p class="lab">{c.s1.n} — {c.s1.label}</p><div><h2>{c.s1.h2}</h2>
  <div class="lst">{c.s1.items.map((i: any, k: number) => <div><span class="num">0{k + 1}</span><div><h3>{i.t}</h3><p>{i.d}</p></div></div>)}</div></div></div></section>

<section class="sec"><div class="wrap grid"><p class="lab">{c.demo.n} — {c.demo.label}</p><div><h2>{c.demo.h2}</h2><p class="mu" style="max-width:560px;margin:-16px 0 28px">{c.demo.d}</p>
  <div class="demo" id="demo" data-t={JSON.stringify(c.demo)}>
    <div class="in"><label>{c.demo.company}<input id="dc" placeholder={c.demo.companyPh} maxlength="40" /></label><label>{c.demo.activity}<input id="da" placeholder={c.demo.activityPh} maxlength="60" /></label></div>
    <div class="tabs"><button type="button" data-m="b" class="on">{c.demo.before}</button><button type="button" data-m="a">{c.demo.after}</button></div>
    <div class="chat"><div class="u"><span class="who">{c.demo.you}</span><p id="dq"></p></div><div class="ai"><span class="who">{c.demo.ai}</span><div id="dans"></div></div></div>
    <small>{c.demo.note}</small>
  </div></div></div></section>

<section class="sec" id="methode"><div class="wrap grid"><p class="lab">{c.method.n} — {c.method.label}</p><div><h2>{c.method.h2}</h2>
  <p style="max-width:640px;margin:0 0 32px;opacity:.75">{c.method.note}</p>
  <div class="steps">{c.method.steps.map((s: any) => <div><span class="when">{s.when}</span><h3>{s.t}</h3><p>{s.d}</p></div>)}</div></div></div></section>

<section class="sec" id="offre"><div class="wrap grid"><p class="lab">{c.offer.n} — {c.offer.label}</p><div><h2>{c.offer.h2}</h2>
  <div class="offerbox"><div><p class="mu">{c.offer.intro}</p><div class="price">{c.offer.price}</div><p class="mu">{c.offer.priceNote}</p><p><a class="btn" href="#audit">{c.offer.cta}</a></p></div>
  <div><p class="lab">{c.offer.incH}</p><ul class="ticks">{c.offer.includes.map((i: string) => <li>{i}</li>)}</ul>
  <div class="two"><div><p class="lab">{c.offer.notH}</p><ul class="ticks no">{c.offer.not.map((i: string) => <li>{i}</li>)}</ul></div><div><p class="lab">{c.offer.clientH}</p><ul class="ticks">{c.offer.client.map((i: string) => <li>{i}</li>)}</ul></div></div></div></div></div></div></section>

<section class="sec" id="pilote"><div class="wrap grid"><p class="lab">{c.pilot.n} — {c.pilot.label}</p><div><h2>{c.pilot.h2}</h2><p class="mu" style="max-width:600px;margin:-16px 0 28px">{c.pilot.d}</p>
  <div class="two"><div><p class="lab">{c.pilot.give}</p><ul class="ticks">{c.pilot.gives.map((i: string) => <li>{i}</li>)}</ul></div><div><p class="lab">{c.pilot.get}</p><ul class="ticks">{c.pilot.gets.map((i: string) => <li>{i}</li>)}</ul></div></div>
  <a class="btn" href="#audit">{c.pilot.cta}</a></div></div></section>

<section class="sec" id="audit"><div class="wrap grid"><p class="lab">{c.form.n} — {c.form.label}</p><div><h2 id="audit-h">{c.form.h2}</h2><p class="mu" style="margin:-16px 0 32px">{c.form.d}</p>
  <form id="f" class="wiz" method="post" action="#audit" aria-labelledby="audit-h" novalidate data-url={url} data-key={key} data-lang={lang} data-ok={c.form.ok} data-err={c.form.err} data-sending={c.form.sending} data-submit={c.form.submit} data-pick={w.pick}>
    <div class="prog" hidden><span class="lab" id="prog-t" aria-live="polite">{w.step} <b>1</b> {w.of} 3</span><span class="bar"><i></i></span></div>
    <fieldset class="step" data-step="1">
      <legend><h3 tabindex="-1">{w.q1}</h3></legend>
      <div class="opts">{w.needs.map((n, i) => <label class="opt"><input class="vh" type="radio" name="need" value={n} required={i === 0} /><span>{n}</span></label>)}</div>
      <p class="err" role="alert"></p>
      <div class="nav"><button class="btn nx" type="button">{w.next} →</button></div>
    </fieldset>
    <fieldset class="step" data-step="2">
      <legend><h3 tabindex="-1">{w.q2}</h3></legend>
      <div class="opts">{w.sectors.map((n, i) => <label class="opt"><input class="vh" type="radio" name="sector" value={n} required={i === 0} /><span>{n}</span></label>)}</div>
      <label class="fld" for="f-detail">{w.detail}</label>
      <input id="f-detail" name="service" maxlength="400" placeholder={c.form.servicePh} enterkeyhint="next" />
      <fieldset class="sub"><legend class="fld">{w.site}</legend>
        <div class="opts sm"><label class="opt"><input class="vh" type="radio" name="hasSite" value="yes" /><span>{w.yes}</span></label><label class="opt"><input class="vh" type="radio" name="hasSite" value="no" /><span>{w.no}</span></label></div>
      </fieldset>
      <div class="urlbox"><label class="fld" for="f-website">{w.url}</label>
      <input id="f-website" name="website" type="text" inputmode="url" autocomplete="url" autocorrect="off" autocapitalize="none" spellcheck="false" maxlength="300" placeholder="monsite.com" /></div>
      <p class="err" role="alert"></p>
      <div class="nav"><button class="bk" type="button">← {w.back}</button><button class="btn nx" type="button">{w.next} →</button></div>
    </fieldset>
    <fieldset class="step" data-step="3">
      <legend><h3 tabindex="-1">{w.q3}</h3></legend>
      <label class="fld" for="f-name">{c.form.name} <span aria-hidden="true">*</span></label>
      <input id="f-name" name="name" required maxlength="120" autocomplete="name" enterkeyhint="next" />
      <label class="fld" for="f-email">{c.form.email} <span aria-hidden="true">*</span></label>
      <input id="f-email" name="email" type="email" required maxlength="200" autocomplete="email" autocorrect="off" autocapitalize="none" spellcheck="false" enterkeyhint="next" />
      <label class="fld" for="f-company">{c.form.company} <span aria-hidden="true">*</span></label>
      <input id="f-company" name="company" required maxlength="160" autocomplete="organization" enterkeyhint="send" />
      <input class="hp" name="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <label class="chk"><input type="checkbox" name="consent" required /><span>{c.form.consent}</span></label>
      <div class="nav"><button class="bk" type="button">← {w.back}</button><button class="btn sb" type="submit">{c.form.submit}</button></div>
    </fieldset>
    <p class="msg" id="msg" role="status" tabindex="-1"></p>
  </form></div></div></section>
</Base>
<script>
  const d = document.getElementById('demo') as HTMLElement | null;
  if (d) {
    let mode = 'b';
    const dc = document.getElementById('dc') as HTMLInputElement, da = document.getElementById('da') as HTMLInputElement;
    const dq = document.getElementById('dq')!, dans = document.getElementById('dans')!;
    const esc = (s: string) => s.replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch] as string));
    const T = JSON.parse(d.dataset.t!);
    const render = () => {
      const co = dc.value.trim() || T.companyPh, ac = da.value.trim() || T.activityPh;
      const fill = (x: string) => esc(x).split('{c}').join(`<strong>${esc(co)}</strong>`).split('{a}').join(esc(ac));
      dq.textContent = T.q.replace('{a}', ac);
      dans.innerHTML = mode === 'b'
        ? `<p>${esc(T.bIntro)}</p><ul>${T.bItems.map((x: string) => `<li>${esc(x)}</li>`).join('')}</ul><p class="mu">${esc(T.bOut)}</p>`
        : `<p>${esc(T.aIntro)}</p><ul><li class="me">${fill(T.aMe)}</li></ul><p class="mu">${esc(T.aOthers)}</p><p class="src">${fill(T.aSrc)}</p>`;
    };
    d.querySelectorAll('.tabs button').forEach(b => b.addEventListener('click', () => { mode = (b as HTMLElement).dataset.m!; d.querySelectorAll('.tabs button').forEach(x => x.classList.toggle('on', x === b)); render(); }));
    dc.addEventListener('input', render); da.addEventListener('input', render); render();
  }
  const f = document.getElementById('f') as HTMLFormElement | null;
  if (f) {
    const s = f.dataset; const msg = document.getElementById('msg')!;
    const steps = [...f.querySelectorAll<HTMLFieldSetElement>('.step')];
    const prog = f.querySelector<HTMLElement>('.prog')!; const progN = prog.querySelector('b')!;
    const urlbox = f.querySelector<HTMLElement>('.urlbox')!;
    const el = (n: string) => f.elements.namedItem(n) as any;
    let cur = 0;
    const show = (i: number, focus = true) => {
      cur = i;
      steps.forEach((st, k) => { st.hidden = k !== i; st.inert = k !== i; });
      progN.textContent = String(i + 1); prog.style.setProperty('--p', String((i + 1) / steps.length));
      if (focus) steps[i].querySelector<HTMLElement>('h3')!.focus();
    };
    const syncUrl = () => { urlbox.hidden = el('hasSite').value !== 'yes'; };
    const stepOk = (i: number) => {
      const st = steps[i]; const err = st.querySelector<HTMLElement>('.err');
      const bad = [...st.querySelectorAll<HTMLInputElement>('input[required]')].find(x => !x.checkValidity());
      if (err) err.textContent = bad ? s.pick! : '';
      if (bad) { (st.querySelector('input') as HTMLInputElement).focus(); return false; }
      return true;
    };
    f.classList.add('js'); prog.hidden = false; syncUrl(); show(0, false);
    f.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (b?.classList.contains('nx') && stepOk(cur)) show(cur + 1);
      if (b?.classList.contains('bk')) show(cur - 1);
    });
    f.addEventListener('change', (e) => {
      const x = e.target as HTMLInputElement;
      if (x.type !== 'radio') return;
      const err = x.closest('.step')!.querySelector<HTMLElement>('.err'); if (err) err.textContent = '';
      if (x.name === 'hasSite') syncUrl();
    });
    // One-click advance for pointer users only; keyboard users move between options with arrows and confirm with Continue
    f.addEventListener('click', (e) => {
      const x = e.target as HTMLInputElement;
      if (x.type === 'radio' && x.name === 'need' && e.detail > 0) setTimeout(() => show(1), 180);
    });
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (el('hp').value) return;
      for (let i = 0; i < steps.length; i++) if (i < 2 && !stepOk(i)) { show(i); return; }
      const bad = [...steps[2].querySelectorAll<HTMLInputElement>('input[required]')].find(x => !x.checkValidity());
      if (bad) { bad.reportValidity(); bad.focus(); return; }
      const btn = f.querySelector<HTMLButtonElement>('.sb')!;
      btn.disabled = true; btn.textContent = s.sending!; msg.textContent = ''; msg.className = 'msg';
      let site = el('hasSite').value === 'yes' ? el('website').value.trim() : '';
      if (site && !/^https?:\/\//i.test(site)) site = 'https://' + site;
      const service = [el('need').value, el('sector').value, el('service').value.trim()].filter(Boolean).join(' · ');
      try {
        const body = { name: el('name').value.trim(), email: el('email').value.trim(), company: el('company').value.trim(), website: site || null, service: service || null, lang: s.lang, consent: el('consent').checked };
        const r = await fetch(`${s.url}/rest/v1/audit_requests`, { method: 'POST', headers: { 'Content-Type': 'application/json', apikey: s.key!, Authorization: `Bearer ${s.key}`, Prefer: 'return=minimal' }, body: JSON.stringify(body) });
        if (!r.ok) throw new Error(String(r.status));
        msg.textContent = s.ok!; msg.className = 'msg ok'; f.reset(); syncUrl(); show(0, false); msg.focus();
      } catch { msg.textContent = s.err!; msg.className = 'msg err'; }
      btn.disabled = false; btn.textContent = s.submit!;
    });
  }
</script>
